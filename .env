# NOTE: the service_role key was removed from this file.
# Any variable prefixed VITE_ is inlined into the browser bundle by Vite and is
# therefore public. The service_role key bypasses Row Level Security entirely,
# so shipping it to the browser would give every visitor unrestricted read and
# write access to applicant PII, personnel records and audit logs.
#
# It belongs only in Edge Function secrets, where the browser can never see it:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# Supabase also injects it automatically into deployed functions, so in practice
# you rarely need to set it by hand.

VITE_APP_NAME="Aloha Security Agency"
VITE_SUPPORT_EMAIL=alohasecuritysupport@gmail.com
